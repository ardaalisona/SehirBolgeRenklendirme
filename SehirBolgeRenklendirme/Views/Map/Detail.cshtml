@* @{
    // Tıklanan ilin ismini URL'den çeker (Örn: Istanbul)
    var cityId = Context.Request.Query["id"];
}

<!-- 1. GÖRÜNÜM AYARLARI (CSS) -->
<style>
    /* Sağdaki Siyah Veri Paneli */
    #graph-panel {
        position: absolute;
        right: 20px;
        top: 80px;
        width: 280px;
        background: rgba(0,0,0,0.9);
        color: #00ff00;
        padding: 20px;
        border-radius: 15px;
        font-family: 'Consolas', monospace;
        border: 2px solid #333;
        z-index: 1000;
        box-shadow: 0 0 20px rgba(0,0,0,0.5);
    }
    /* Haritadaki İlçeler */
    path {
        fill: #ddd;
        stroke: #fff;
        stroke-width: 1.5;
        transition: 0.3s;
        cursor: pointer;
    }

        path:hover {
            fill: #007bff;
        }

    .title-area {
        margin-top: 20px;
        font-weight: bold;
    }
</style>

<div class="container-fluid text-center">
    <div class="title-area">
        <h2 class="display-6">@cityId İli Bölge Analizi</h2>
        <p class="text-muted">Graf Teorisi - Euler Formülü ve 4-Renk Algoritması</p>
    </div>
    <hr />

    <!-- SOL TARAF: Harita Çizim Alanı -->
    <div id="map-area" style="max-width: 800px; margin: auto; border: 1px solid #eee; background: #fafafa; border-radius: 10px;">
        <svg id="citySvg" viewBox="0 0 800 450" width="100%">
            <!-- BURAYA SEÇİLEN İLİN (İSTANBUL/ANKARA) İLÇE PATH'LERİ GELECEK -->
            <!-- Örnek: <path id="Besiktas" d="..." /> -->
        </svg>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary btn-lg px-5" onclick="analiziBaslat()">
            Sistemi Çalıştır ve Renklendir
        </button>
    </div>

    <!-- SAĞ TARAF: Senin İstediğin O Siyah Kutu -->
    <div id="graph-panel">
        <h3 style="border-bottom: 2px solid #00ff00; font-size: 18px; padding-bottom: 10px;">GRAFİK VERİLERİ</h3>
        <div style="text-align: left; margin-top: 15px; line-height: 2;">
            <p>Köşeler (V): <span id="v-count" style="color:#f1c40f">0</span></p>
            <p>Kenarlar (E): <span id="e-count" style="color:#f1c40f">0</span></p>
            <p>Yüzler (F): <span id="f-count" style="color:#f1c40f">0</span></p>
            <p>Düzlemsel: <span id="is-planar" style="color:#fff">BEKLENİYOR</span></p>
        </div>

        <hr style="border-color: #444;">

        <!-- EL ÇİZİMİNİN (DÜĞÜM-KENAR) CANLANACAĞI YER -->
        <h4 style="font-size: 14px; color: #00ff00; margin-bottom: 10px;">KOMŞULUK GRAFI (Network)</h4>
        <div id="network-graph" style="width: 100%; height: 230px; background: #050505; border-radius: 8px;"></div>
    </div>
</div>

<!-- KÜTÜPHANELER -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://d3js.org/d3.v7.min.js"></script>

<!-- ASIL MOTOR (JAVASCRIPT) -->
<script>
    function analiziBaslat() {
        // Backend'e (MapController) istek atar
        $.post('/Map/ProcessColoring', { cityName: "@cityId" }, function (res) {
            if (res.success) {
                // 1. Haritayı Boya (4-Renk Algoritması Sonucu)
                const colors = ["", "#e74c3c", "#3498db", "#2ecc71", "#f1c40f"];
                res.data.forEach(item => {
                    $("#" + item.name).css("fill", colors[item.colorId]);
                });

                // 2. Siyah Paneli Güncelle
                $("#v-count").text(res.data.length);
                let e = res.data.reduce((acc, curr) => acc + curr.neighbors.length, 0) / 2;
                $("#e-count").text(e);
                $("#f-count").text(e - res.data.length + 2); // Euler: F = E - V + 2
                $("#is-planar").text(res.isEuler ? "EVET ✅" : "HAYIR ❌");

                // 3. EL ÇİZİMİN GİBİ GRAFI ÇİZ
                cizDugumGrafi(res.data);
            } else {
                alert("Hata: " + res.message);
            }
        });
    }

    // 1. Fotoğraftaki Çizimi Canlandıran Fonksiyon
    function cizDugumGrafi(districts) {
        d3.select("#network-graph").selectAll("*").remove();
        const width = 240, height = 230;
        const svg = d3.select("#network-graph").append("svg").attr("width", width).attr("height", height);

        const nodes = districts.map(d => ({ id: d.name }));
        const links = [];
        districts.forEach(d => {
            d.neighbors.forEach(n => { links.push({ source: d.name, target: n }); });
        });

        const simulation = d3.forceSimulation(nodes)
            .force("link", d3.forceLink(links).id(d => d.id).distance(35))
            .force("charge", d3.forceManyBody().strength(-80))
            .force("center", d3.forceCenter(width / 2, height / 2));

        const link = svg.append("g").selectAll("line").data(links).join("line")
            .attr("stroke", "#555").attr("stroke-width", 1.5);

        const node = svg.append("g").selectAll("circle").data(nodes).join("circle")
            .attr("r", 10).attr("fill", "#00ff00").attr("stroke", "#fff").attr("stroke-width", 1)
            .call(d3.drag().on("start", dragStarted).on("drag", dragged).on("end", dragEnded));

        const text = svg.append("g").selectAll("text").data(nodes).join("text")
            .text(d => d.id.substring(0, 3)).attr("font-size", "9px").attr("fill", "#fff").attr("dx", 12).attr("dy", 4);

        simulation.on("tick", () => {
            link.attr("x1", d => d.source.x).attr("y1", d => d.source.y).attr("x2", d => d.target.x).attr("y2", d => d.target.y);
            node.attr("cx", d => d.x).attr("cy", d => d.y);
            text.attr("x", d => d.x).attr("y", d => d.y);
        });

        function dragStarted(e, d) { if (!e.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; }
        function dragged(e, d) { d.fx = e.x; d.fy = e.y; }
        function dragEnded(e, d) { if (!e.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; }
    }
</script> *@